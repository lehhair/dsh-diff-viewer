{
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "es2022",
    "lib": [
      "es2022",
      "es2023"
    ],
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@deepseek-ai/dsh-client-runtime": [
        "../test-lehhair/packages/client/runtime/src/index.ts"
      ],
      "@deepseek-ai/dsh-client-runtime/client": [
        "../test-lehhair/packages/client/runtime/src/client/index.ts"
      ],
      "@deepseek-ai/dsh-client-ui-slots": [
        "../test-lehhair/packages/client/ui-slots/src/index.ts"
      ],
      "@deepseek-ai/dsh-client-ui-primitives": [
        "../test-lehhair/packages/client/ui-primitives/src/index.ts"
      ],
      "@deepseek-ai/dsh-client-locale/client": [
        "../test-lehhair/packages/client/locale/src/client/index.ts"
      ],
      "@deepseek-ai/dsh-client-test-runtime": [
        "../test-lehhair/packages/client/test-runtime/src/index.ts"
      ],
      "@deepseek-ai/dsh-client-test-runtime/client": [
        "../test-lehhair/packages/client/test-runtime/src/client/index.ts"
      ]
    }
  },
  "include": [
    "src"
  ],
  "exclude": [
    "src/client"
  ]
}
